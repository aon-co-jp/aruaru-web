# aruaru-web / aruaru-db 系サービス用 Nginx vhost テンプレート。
# KUSANAGIのような「ドメインごとのvhost追加」を簡易に行うためのひな形。
# {{PLACEHOLDER}} は scripts/gen-vhost.sh が埋める。
#
# 実際のドメイン取得・DNS登録(Aレコード追加など)は各自レジストラ側で
# 事前に完了させておくこと。このファイルはローカルのリバースプロキシ設定と
# TLS(HTTPS)設定のみを扱う。TLS証明書自体は scripts/setup-tls.sh
# (Let's Encrypt / certbot)で取得・自動更新する。

# 80番: ACME challenge 応答 + HTTPSへのリダイレクト。
server {
    listen {{IP}}:80;
    server_name {{DOMAIN}};

    location /.well-known/acme-challenge/ {
        root {{WEBROOT}};
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 443番: 本番トラフィック。証明書は certbot (Let's Encrypt) が管理する。
server {
    listen {{IP}}:443 ssl;
    http2 on;
    server_name {{DOMAIN}};

    ssl_certificate     /etc/letsencrypt/live/{{DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{DOMAIN}}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root {{WEBROOT}};
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # aruaru-db (aruaru-graphql) など、バックエンドAPIへのリバースプロキシ。
    location /graphql {
        proxy_pass http://{{UPSTREAM}};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
