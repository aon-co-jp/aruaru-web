# WordPress高速化用 Nginx vhost テンプレート(スタック: wordpress)。
# KUSANAGIのWordPress高速化設定を参考にした、Nginx側でできる範囲の
# 高速化設定(gzip・静的アセットキャッシュ・FastCGIバッファ調整)を含む。
# {{PLACEHOLDER}} は scripts/gen-vhost.sh が埋める。UPSTREAMには
# PHP-FPMのソケットまたはTCPアドレスを指定する
# (例: unix:/run/php/php8.3-fpm.sock または 127.0.0.1:9000)。
#
# 実際のドメイン取得・DNS登録(Aレコード追加など)は各自レジストラ側で
# 事前に完了させておくこと。TLS証明書自体は scripts/setup-tls.sh
# (Let's Encrypt / certbot)で取得・自動更新する。
# OPcache・Redis/Memcachedオブジェクトキャッシュの有効化はPHP側
# (php.ini・wp-config.php)で行うこと。本テンプレートはWebサーバー側の
# 高速化設定のみを担当する。

# 80番: ACME challenge 応答 + HTTPSへのリダイレクト。
server {
    listen {{IP}}:80;
    server_name {{DOMAIN}};

    location /.well-known/acme-challenge/ {
        root {{WEBROOT}};
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 443番: WordPress配信(高速化設定込み)。
server {
    listen {{IP}}:443 ssl http2;
    server_name {{DOMAIN}};

    ssl_certificate     /etc/letsencrypt/live/{{DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{DOMAIN}}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root {{WEBROOT}};
    index index.php index.html;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types text/plain text/css application/json application/javascript
        text/xml application/xml application/xml+rss text/javascript
        image/svg+xml;

    client_max_body_size 64m;

    # WordPressのパーマリンク(フロントコントローラパターン)。
    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    # 静的アセットは長期キャッシュしてPHPを経由させない。
    location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # wp-config.php・.htaccess等の機密ファイルは直接配信しない。
    location ~ /(?:wp-config\.php|\.htaccess|\.git) {
        deny all;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass {{UPSTREAM}};
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        # PHP-FPM側のレスポンスバッファを広げてスワップ(一時ファイル化)を防ぐ。
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_read_timeout 60s;
    }
}
