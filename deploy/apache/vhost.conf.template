# aruaru-web / aruaru-db 系サービス用 Apache httpd VirtualHost テンプレート。
# {{PLACEHOLDER}} は scripts/gen-vhost.sh が埋める。
# TLS証明書は scripts/setup-tls.sh (Let's Encrypt / certbot) が取得・自動更新する。
# 事前に mod_ssl / mod_proxy / mod_rewrite を有効化しておくこと
# (a2enmod ssl proxy proxy_http rewrite)。

<VirtualHost {{IP}}:80>
    ServerName {{DOMAIN}}
    DocumentRoot "{{WEBROOT}}"

    # ACME challenge 用のパスはHTTPのまま許可し、それ以外はHTTPSへリダイレクト。
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</VirtualHost>

<VirtualHost {{IP}}:443>
    ServerName {{DOMAIN}}
    DocumentRoot "{{WEBROOT}}"

    SSLEngine on
    SSLCertificateFile      /etc/letsencrypt/live/{{DOMAIN}}/fullchain.pem
    SSLCertificateKeyFile   /etc/letsencrypt/live/{{DOMAIN}}/privkey.pem

    <Directory "{{WEBROOT}}">
        Require all granted
        AllowOverride None
    </Directory>

    ProxyPreserveHost On
    ProxyPass "/graphql" "http://{{UPSTREAM}}/graphql"
    ProxyPassReverse "/graphql" "http://{{UPSTREAM}}/graphql"
</VirtualHost>
